///removing space from string
class Main {
    public static void main(String[] args) {
        String s = "hello world";
        String t = " ";

        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);

            if (ch == ' ') {
                // skip space
            } else {
                t = t + ch;
            }
        }

        System.out.println(t);
    }
}
