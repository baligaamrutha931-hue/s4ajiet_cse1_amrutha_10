///Finding the largest element in the array

class Main {
    public static void main(String[] args) {
        int [] arr={10,20,30,40,50};
        System.out.println("4TH ARRAY IS: "+arr[3]);
        arr[2]=60;
        int n=arr.length;
        for(int i=0;i<5;i++){
            System.out.println(arr[i]);
            
        }
        System.out.println("length of the array is:"+n);
    }
}

///Finding the smallest element in the array

class Main {
    public static void main(String[] args) {
       int [] arr={70,20,60,40,50};
        System.out.println("Array is:");
        for(int i=0;i<5;i++){
            System.out.println(arr[i]);
            
        }
        int small=arr[0];
        for(int i=1;i<5;i++){
            if(arr[i]<small){
                    small=arr[i];
        }
    }
    System.out.println("smallest ele is:"+small);
    }
}
